{
  "schema": 1,
  "abi": { "major": 0, "minor": 6, "patch": 0 },
  "platform": "android",
  "gpu_backends": ["vulkan", "gles"],
  "protocols": ["http"],
  "presentation": {
    "external_surface": true,
    "texture_sharing": false,
    "attach_before_load": true,
    "embedded": true,
    "detached": false,
    "surface_kinds": ["android_native_window"]
  },
  "features": {
    "video_codecs": ["h264", "h265"],
    "audio_codecs": ["aac", "flac"],
    "subtitle_formats": ["srt", "ass", "ssa"],
    "embedded_ass_styling": true,
    "track_switching": true,
    "hw_decode": false,
    "danmaku_formats": ["bilibili_xml"],
    "danmaku_xml_entities": true,
    "seek_modes": ["exact", "keyframe"],
    "overlay_in_core": true
  },
  "limits": { "max_texture_dimension_2d": 2048 }
}
