{
  "schema": 1,
  "states": ["idle", "loading", "ready", "playing", "paused", "ended", "stopped", "error"],
  "notes": {
    "accepted": "命令入队后成功；to 为落点，same 表示状态不变且不发 state_changed",
    "to_array": "load_file 的 to 列出 loading 与最终状态 ready/error",
    "rejected": "通过 command_completed(status=error) 异步拒绝，不是同步拒绝",
    "select_track": "换轨是按新轨道组合重开管线，因此同样经过 loading；完成后重发 file_loaded（携带更新过的 media.tracks），客户端照旧重读快照",
    "set_decode_mode": "ready/playing/paused 切解码方式是重开管线：经过 loading，完成后落回原状态，不重发 file_loaded，位置由内部 seek 保持；idle/ended/stopped/error 只持久化设置，在下一次打开或重开时生效"
  },
  "reject": {
    "channel": "command_completed",
    "status": "error",
    "error": { "code": "invalid_state", "code_num": -2 }
  },
  "matrix": {
    "load_file": {
      "idle": { "status": "accepted", "to": ["loading", "ready", "error"] },
      "loading": { "status": "accepted", "to": ["loading", "ready", "error"], "cancels_inflight_load": true },
      "ready": { "status": "accepted", "to": ["loading", "ready", "error"] },
      "playing": { "status": "accepted", "to": ["loading", "ready", "error"] },
      "paused": { "status": "accepted", "to": ["loading", "ready", "error"] },
      "ended": { "status": "accepted", "to": ["loading", "ready", "error"] },
      "stopped": { "status": "accepted", "to": ["loading", "ready", "error"] },
      "error": { "status": "accepted", "to": ["loading", "ready", "error"] }
    },
    "play": {
